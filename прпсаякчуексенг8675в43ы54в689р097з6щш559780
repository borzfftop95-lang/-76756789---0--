async def check_subscription(user_id: int) -> bool:
    """Проверяет подписку на ОБА обязательных чата"""
    required_chats = [CHANNEL_ID, NEW_GROUP_ID]
    for chat_id in required_chats:
        try:
            member = await bot.get_chat_member(chat_id=chat_id, user_id=user_id)
            if member.status not in ["creator", "administrator", "member"]:
                return False
        except Exception as e:
            logger.error(f"Ошибка проверки подписки на {chat_id}: {e}")
            return False
    return True

async def pre_check(user_id: int) -> bool:
    update_user_activity(user_id)
    if is_user_banned(user_id):
        return False
    db = load_db()
    if db["maintenance"] and user_id != ADMIN_ID:
        return False
    return True

