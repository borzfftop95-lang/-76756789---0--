        if is_user_banned(user.id):
            await message.answer("<b>❌ Ваш аккаунт заблокирован!</b>", parse_mode="HTML")
        else:
            await message.answer("<b>🛠 Бот на техническом обслуживании.</b>", parse_mode="HTML")
        return

    await state.clear()
    is_sub = await check_subscription(user.id)
    if not is_sub:
        await message.answer(
            "<b>Для использования бота необходима подписка на оба канала/группы:</b>\n\n"
            "1. Подпишитесь на <b>Frozen CRM Project</b>\n"
            "2. Подпишитесь на <b>Бесплатный приват</b>\n"
            "3. Нажмите кнопку «Проверить подписку»",
            reply_markup=get_sub_keyboard(),
            parse_mode="HTML"
        )
        return

    welcome_text = (
        "<b>Shishani Tools — бот-помощник для навигации по проектам и конвертации файлов SHISHANI</b>\n\n"
