def load_db() -> dict:
    default_db = {
        "users": {},
        "conversions_count": 0,
        "maintenance": False,
        "private_threshold": 100
    }
    try:
        if os.path.exists(DATA_FILE):
            with open(DATA_FILE, 'r', encoding='utf-8') as f:
                data = json.load(f)
                for key in default_db:
                    if key not in data:
                        data[key] = default_db[key]
                return data
        return default_db
    except Exception as e:
        logger.error(f"Ошибка загрузки БД: {e}")
        return default_db

def save_db(db_data: dict):
    try:
        with open(DATA_FILE, 'w', encoding='utf-8') as f:
            json.dump(db_data, f, ensure_ascii=False, indent=2)
    except Exception as e:
        logger.error(f"Ошибка сохранения БД: {e}")

def update_user_activity(user_id: int):
    db = load_db()
    uid_str = str(user_id)
    now_str = datetime.now().isoformat()
    if uid_str not in db["users"]:
        db["users"][uid_str] = {
            "joined": now_str,
            "last_active": now_str,
            "banned": False
        }
    else:
        db["users"][uid_str]["last_active"] = now_str
    save_db(db)

def is_user_banned(user_id: int) -> bool:
    db = load_db()
    return db["users"].get(str(user_id), {}).get("banned", False)

def increment_conversions(count: int = 1):
    db = load_db()
    db["conversions_count"] += count
    save_db(db)

def get_stats() -> dict:
    db = load_db()
    users = db["users"]
    now = datetime.now()
    total_users = len(users)
    banned_users = sum(1 for u in users.values() if u.get("banned", False))

    online_15m = 0
    active_24h = 0
    for u in users.values():
        last_active_str = u.get("last_active")
        if last_active_str:
            try:
                last_active = datetime.fromisoformat(last_active_str)
                delta = now - last_active
                if delta <= timedelta(minutes=15):
                    online_15m += 1
                if delta <= timedelta(hours=24):
                    active_24h += 1
            except Exception:
                pass
    return {
        "total_users": total_users,
        "online_15m": online_15m,
        "active_24h": active_24h,
        "banned_users": banned_users,
        "conversions_count": db["conversions_count"],
        "maintenance": db["maintenance"],
        "private_threshold": db["private_threshold"]
    }

# ==================== RENDERWARE & FILE CONVERTER ENGINE ====================
RW_CLUMP_ID      = b"\x10\x00\x00\x00"   # 0x10 — Clump (DFF)
RW_TXD_ID        = b"\x16\x00\x00\x00"   # 0x16 — Texture Dictionary
RW_FRAMELIST_ID  = b"\x0e\x00\x00\x00"   # 0x0E — Frame List
RW_VERSION_SA    = 0x1803FFFF

def find_ascii_names(data: bytes) -> set:
    result = set()
    strings = re.findall(rb"[A-Za-z0-9_\-]{3,32}", data)
    for s in strings:
        try:
            name = s.decode("utf-8").lower()
            result.add(name)
        except Exception:
            pass
    return result

def scan_dff(data: bytes) -> list:
    names = find_ascii_names(data)
    blacklist = {"clump", "geometry", "atomic", "frame", "texture", "material"}
    return [x for x in names if x not in blacklist]

def scan_txd(data: bytes) -> set:
    return find_ascii_names(data)

def compare_dff_txd(dff_bytes: bytes, txd_bytes: bytes):
    need = scan_dff(dff_bytes)
    have = scan_txd(txd_bytes)
    found = [tex for tex in need if tex in have]
    missing = [tex for tex in need if tex not in have]
    return found, missing

class FileConverter:
    @staticmethod
    def read_rw_chunk(data: bytes, offset: int):
        if offset + 12 > len(data):
            return None
        chunk_id = int.from_bytes(data[offset:offset+4], "little")
        size = int.from_bytes(data[offset+4:offset+8], "little")
        version = data[offset+8:offset+12]
        end = offset + 12 + size
        if end > len(data) or size == 0:
            return None
        return {"id": chunk_id, "size": size, "version": version, "start": offset, "end": end}

    @classmethod
    def find_clump(cls, data: bytes) -> int:
        if not data or len(data) < 12:
            return -1
        for offset in range(len(data) - 12):
            if data[offset:offset+4] == RW_CLUMP_ID:
                chunk = cls.read_rw_chunk(data, offset)
                if chunk and chunk["id"] == 0x10:
                    return offset
        return -1

    @classmethod
    def check_dff(cls, data: bytes) -> bool:
        return cls.find_clump(data) >= 0

    @classmethod
    def decrypt_xor_bytes(cls, data: bytes, key: int = None) -> bytes:
        if not data:
            return data
        if key is not None:
            return bytes(b ^ key for b in data)
        if cls.check_dff(data):
            return data
        for k in range(1, 256):
            test_decoded = bytes(b ^ k for b in data)
            if cls.check_dff(test_decoded):
                return test_decoded
        common_keys = [
            b"SHISHANI", b"FROZEN", b"CRMP", b"MODEL", b"TXD",
            b"SHISHANI_TOOLS", b"PROTECT", b"PRIVAT", b"ZMODELER",
            b"\xAA\xBB\xCC\xDD", b"\xFF\xFE\xFD\xFC"
        ]
        for ckey in common_keys:
            decoded = bytes(data[i] ^ ckey[i % len(ckey)] for i in range(len(data)))
            if cls.check_dff(decoded):
                return decoded
        inverted = bytes((~b) & 0xFF for b in data)
        if cls.check_dff(inverted):
            return inverted
        return data

    @classmethod
    def unprotect_rw_model(cls, data_input: bytes) -> bytes:
        if not data_input:
            return data_input
        decoded = cls.decrypt_xor_bytes(data_input)
        pos = cls.find_clump(decoded)
        if pos >= 0:
            data = bytearray(decoded[pos:])
        else:
            frame_pos = decoded.find(RW_FRAMELIST_ID)
            if 0 < frame_pos <= 256:
                clean_header = (
                    RW_CLUMP_ID +
                    (len(decoded) - frame_pos).to_bytes(4, "little") +
                    struct.pack("<I", RW_VERSION_SA)
                )
                data = bytearray(clean_header + decoded[frame_pos:])
            else:
                data = bytearray(decoded)

        length = len(data)
        curr_pos = 0
        CHUNK_CLUMP         = 0x10
        CHUNK_FRAME_LIST    = 0x0E
        CHUNK_GEOMETRY_LIST = 0x1A
        CHUNK_GEOMETRY      = 0x0F

        while curr_pos <= length - 12:
            chunk_type, chunk_size, chunk_ver = struct.unpack("<III", data[curr_pos:curr_pos + 12])
            if (chunk_ver & 0xFFFF0000) != 0x18000000 and chunk_type in (
                CHUNK_CLUMP, CHUNK_FRAME_LIST, CHUNK_GEOMETRY_LIST, CHUNK_GEOMETRY
            ):
                struct.pack_into("<I", data, curr_pos + 8, RW_VERSION_SA)
            if chunk_type == CHUNK_FRAME_LIST:
                struct_pos = curr_pos + 12
                if struct_pos + 16 <= length:
                    num_frames = struct.unpack("<I", data[struct_pos + 12:struct_pos + 16])[0]
                    if num_frames == 0 or num_frames > 4096:
                        actual_frames = (chunk_size - 4) // 56
                        if actual_frames > 0:
                            struct.pack_into("<I", data, struct_pos + 12, actual_frames)
                if struct_pos + 8 <= length:
                    struct.pack_into("<I", data, struct_pos + 8, RW_VERSION_SA)
            step = 12 + chunk_size
            if step <= 0 or (curr_pos + step) > length:
                break
            curr_pos += step
        return bytes(data)

    @staticmethod
    def png_to_bmp(input_bytes: bytes) -> bytes:
        img = Image.open(io.BytesIO(input_bytes))
        if img.mode in ('RGBA', 'LA', 'P'):
            rgb = Image.new('RGB', img.size, (255, 255, 255))
            if img.mode == 'P':
                img = img.convert('RGBA')
            if img.mode in ('RGBA', 'LA'):
                rgb.paste(img, mask=img.split()[-1])
            else:
                rgb.paste(img)
            img = rgb
        out = io.BytesIO()
        img.save(out, format='BMP')
        return out.getvalue()

    @staticmethod
    def bmp_to_png(input_bytes: bytes) -> bytes:
        img = Image.open(io.BytesIO(input_bytes))
        out = io.BytesIO()
        img.save(out, format='PNG')
        return out.getvalue()

    @staticmethod
    def txd_to_png(input_bytes: bytes) -> bytes:
        if not input_bytes.startswith(RW_TXD_ID):
            input_bytes = FileConverter.unprotect_rw_model(input_bytes)

        def read_chunk(data, offset):
            if offset + 12 > len(data):
                return None
            ctype, csize, cver = struct.unpack_from('<III', data, offset)
            return ctype, csize, cver, offset + 12, data[offset + 12:offset + 12 + csize]

        def find_native(data):
            pos = 0
            while pos < len(data) - 12:
                chunk = read_chunk(data, pos)
                if not chunk:
                    break
                ctype, csize, _, next_pos, payload = chunk
                if ctype == 0x15:
                    return payload
                elif ctype == 0x16:
                    inner = find_native(payload)
                    if inner:
                        return inner
                pos = next_pos + csize
            return None

        native = find_native(input_bytes)
        if not native:
            raise ValueError("Не найден заголовок Native Texture (0x15)")

        struct_data = None
        pos = 0
        while pos < len(native) - 12:
            chunk = read_chunk(native, pos)
            if not chunk:
                break
            ctype, csize, _, next_pos, payload = chunk
            if ctype == 0x01:
                struct_data = payload
                break
            pos = next_pos + csize

        if struct_data is None:
            raise ValueError("Внутри Native Texture не найден Struct (0x01)")

        if len(struct_data) < 88:
            width = struct.unpack_from('<H', struct_data, 12)[0]
            height = struct.unpack_from('<H', struct_data, 14)[0]
            raw = struct_data[72:]
        else:
            width = struct.unpack_from('<H', struct_data, 80)[0]
            height = struct.unpack_from('<H', struct_data, 82)[0]
            flags = struct.unpack_from('<I', struct_data, 72)[0] if len(struct_data) > 72 else 0
            raw = struct_data[88:]

        is_dxt = False
        dxt_type = 0
        if flags & 0x10:
            is_dxt, dxt_type = True, 1
        elif flags & 0x20:
            is_dxt, dxt_type = True, 3
        elif flags & 0x30:
            is_dxt, dxt_type = True, 5

        if texture2ddecoder and is_dxt:
            try:
                if dxt_type == 1:
                    decoded = texture2ddecoder.decode_dxt1(raw, width, height)
                else:
                    decoded = texture2ddecoder.decode_dxt5(raw, width, height)
                img = Image.frombytes('RGBA', (width, height), decoded, 'raw', 'BGRA')
                out = io.BytesIO()
                img.save(out, format='PNG')
                return out.getvalue()
            except Exception as e:
                logger.warning(f"Ошибка DXT декодирования: {e}")

        expected_size = width * height * 4
        if len(raw) >= expected_size:
            raw = raw[:expected_size]
            img = Image.frombytes('RGBA', (width, height), raw, 'raw', 'BGRA')
            out = io.BytesIO()
            img.save(out, format='PNG')
            return out.getvalue()
        raise ValueError("Неподдерживаемый формат упакованных пикселей TXD")

    @staticmethod
    def png_to_txd(input_bytes: bytes, tex_name: str = "texture") -> bytes:
        img = Image.open(io.BytesIO(input_bytes)).convert('RGBA')
        width, height = img.size
        r, g, b, a = img.split()
        bgra = Image.merge('RGBA', (b, g, r, a))
        pixel_data = bgra.tobytes()

        def make_chunk(ctype, data, version=0x1803FFFF):
            return struct.pack('<III', ctype, len(data), version) + data

        name = tex_name.encode('ascii', 'ignore')[:31].ljust(32, b'\x00')
        mask = b'\x00' * 32
        struct_header = struct.pack('<II', 0x00000004, 0x00001100)
        raster_header = struct.pack('<IIHHBB', 0x00000000, len(pixel_data), width, height, 32, 1)
        padding = b'\x00\x00'
        struct_data = struct_header + name + mask + raster_header + padding + pixel_data
        struct_chunk = make_chunk(0x01, struct_data)
        ext_chunk = make_chunk(0x03, b'')
        native_chunk = make_chunk(0x15, struct_chunk + ext_chunk)
        txd_struct = make_chunk(0x01, struct.pack('<HH', 1, 0))
        return make_chunk(0x16, txd_struct + native_chunk + ext_chunk)

    @staticmethod
    def create_multi_txd_from_pngs(png_dict: dict) -> bytes:
        if len(png_dict) == 1:
            name, data = list(png_dict.items())[0]
            stem = os.path.splitext(name)[0]
            return FileConverter.png_to_txd(data, tex_name=stem)
        result = b""
        for name, img_bytes in png_dict.items():
            stem = os.path.splitext(name)[0]
            try:
                result += FileConverter.png_to_txd(img_bytes, tex_name=stem)
            except Exception as e:
                logger.error(f"Ошибка упаковки {name}: {e}")
        return result

    @staticmethod
    def btx_to_png(input_bytes: bytes) -> bytes:
        png_start = input_bytes.find(b'\x89PNG\r\n\x1a\n')
        if png_start != -1:
            return input_bytes[png_start:]
        try:
            if len(input_bytes) < 16:
                raise ValueError("Файл BTX слишком мал")
            width = struct.unpack_from('<H', input_bytes, 4)[0]
            height = struct.unpack_from('<H', input_bytes, 6)[0]
            if width > 0 and height > 0 and texture2ddecoder:
                raw = input_bytes[16:]
                decoded = texture2ddecoder.decode_etc2(raw, width, height)
                img = Image.frombytes('RGBA', (width, height), decoded, 'raw', 'BGRA')
                out = io.BytesIO()
                img.save(out, format='PNG')
                return out.getvalue()
        except Exception as e:
            logger.warning(f"Ошибка декодирования ETC2: {e}")
        raise ValueError("Формат BTX не содержит PNG или поврежден")

    @staticmethod
    def png_to_btx(input_bytes: bytes) -> bytes:
        img = Image.open(io.BytesIO(input_bytes))
        width, height = img.size
        png_out = io.BytesIO()
        img.save(png_out, format='PNG')
        pdata = png_out.getvalue()
        header = struct.pack('<4sHHII', b'BTX\x00', width, height, 1, len(pdata))
        return header + pdata

    @staticmethod
    def txd_to_btx(input_bytes: bytes) -> bytes:
        png_data = FileConverter.txd_to_png(input_bytes)
        return FileConverter.png_to_btx(png_data)

    @staticmethod
    def btx_to_txd(input_bytes: bytes) -> bytes:
        png_data = FileConverter.btx_to_png(input_bytes)
        return FileConverter.png_to_txd(png_data)

