@dp.callback_query(F.data == "batch_convert_all")
async def process_batch_convert_all(callback: types.CallbackQuery):
    user_id = callback.from_user.id
    if user_id not in user_batch_buffers or not user_batch_buffers[user_id]["files"]:
        await safe_answer_callback(callback, "Файлы не найдены! Загрузите файлы снова.", show_alert=True)
        return

    files = user_batch_buffers[user_id]["files"]
    await callback.message.edit_text("<b>🔄 Автоматическая конвертация и обработка всех файлов...</b>", parse_mode="HTML")

    converted_files = {}
    converter = FileConverter()

    for name, data in files.items():
        low = name.lower()
        stem = os.path.splitext(name)[0]
        try:
            if low.endswith(".mod"):
                clean = converter.unprotect_rw_model(data)
                converted_files[f"{stem}.dff"] = clean
            elif low.endswith(".png"):
                btx_data = converter.png_to_btx(data)
                converted_files[f"{stem}.btx"] = btx_data
            elif low.endswith(".txd"):
                btx_data = converter.txd_to_btx(data)
                converted_files[f"{stem}.btx"] = btx_data
            elif low.endswith(".btx"):
                txd_data = converter.btx_to_txd(data)
                converted_files[f"{stem}.txd"] = txd_data
            elif low.endswith(".bmp"):
                png_data = converter.bmp_to_png(data)
                converted_files[f"{stem}.png"] = png_data
            else:
                converted_files[name] = data
        except Exception as e:
            logger.error(f"Ошибка конвертации файла {name}: {e}")
            converted_files[name] = data

    increment_conversions(len(converted_files))

    if len(converted_files) == 1:
        fname, fbytes = list(converted_files.items())[0]
        doc = BufferedInputFile(fbytes, filename=fname)
        await callback.message.answer_document(doc, caption=f"<b>✅ Файл успешно обработан: {fname}</b>", parse_mode="HTML")
    else:
        zip_buf = io.BytesIO()
        with zipfile.ZipFile(zip_buf, "w", zipfile.ZIP_DEFLATED) as zout:
            for fname, fbytes in converted_files.items():
                zout.writestr(fname, fbytes)
        zip_buf.seek(0)
        doc = BufferedInputFile(zip_buf.read(), filename="converted_files.zip")
        await callback.message.answer_document(doc, caption=f"<b>✅ Пакетная конвертация {len(converted_files)} файлов завершена!</b>", parse_mode="HTML")

    del user_batch_buffers[user_id]
    await safe_answer_callback(callback)

