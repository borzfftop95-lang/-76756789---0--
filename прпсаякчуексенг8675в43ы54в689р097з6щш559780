@dp.message(F.document)
async def process_incoming_documents(message: types.Message):
    user_id = message.from_user.id
    if not await pre_check(user_id):
        return

    doc = message.document
    filename = doc.file_name
    low_name = filename.lower()
    valid_extensions = [".dff", ".txd", ".mod", ".btx", ".png", ".bmp", ".zip"]

    if not any(low_name.endswith(ext) for ext in valid_extensions):
        await message.reply("⚠️ Неподдерживаемый формат файла!")
        return

    file_io = await bot.download(doc.file_id)
    file_bytes = file_io.read()

    if user_id not in user_batch_buffers:
        user_batch_buffers[user_id] = {"files": {}, "msg_id": None}

    buf = user_batch_buffers[user_id]

    if low_name.endswith(".zip"):
        try:
            with zipfile.ZipFile(io.BytesIO(file_bytes), "r") as z:
                for item in z.infolist():
                    if item.is_dir():
                        continue
                    fname = os.path.basename(item.filename)
                    if any(fname.lower().endswith(ext) for ext in valid_extensions if ext != ".zip"):
                        buf["files"][fname] = z.read(item.filename)
        except Exception as e:
            logger.error(f"Ошибка распаковки ZIP: {e}")
            await message.reply("❌ Ошибка чтения ZIP архива.")
            return
    else:
        buf["files"][filename] = file_bytes

    count = len(buf["files"])
    file_list_str = "\n".join([f"• <code>{name}</code>" for name in list(buf["files"].keys())[:10]])
    if count > 10:
        file_list_str += f"\n...и еще {count - 10} файлов"

    menu_text = (
        f"<b>📥 Получено файлов: {count}</b>\n\n"
        f"{file_list_str}\n\n"
        "<b>Выберите необходимое действие с файлами:</b>"
    )

    if buf["msg_id"]:
        try:
            await bot.edit_message_text(
                chat_id=message.chat.id,
                message_id=buf["msg_id"],
                text=menu_text,
                reply_markup=get_batch_actions_keyboard(),
                parse_mode="HTML"
            )
            return
        except Exception:
            pass

    sent_msg = await message.answer(menu_text, reply_markup=get_batch_actions_keyboard(), parse_mode="HTML")
    buf["msg_id"] = sent_msg.message_id

